#!/usr/bin/env bash
# scenic-motion-engine pre-commit hook.
# Install via: make install-hooks
#
# Runs cargo fmt --check, cargo clippy -D warnings, and cargo test --lib.
# Exits with a one-line error naming the failing step if any check fails.
set -eo pipefail

if ! cargo fmt --all -- --check >/dev/null; then
    echo "pre-commit: cargo fmt --check failed (run 'make fmt')" >&2
    exit 1
fi

if ! cargo clippy --all-targets -- -D warnings; then
    echo "pre-commit: cargo clippy -D warnings failed" >&2
    exit 1
fi

if ! cargo test --lib; then
    echo "pre-commit: cargo test --lib failed" >&2
    exit 1
fi

exit 0
